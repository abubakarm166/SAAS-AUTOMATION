# SnapShot API — copy to backend/.env and fill values.
# After changing keys, restart the API.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snapshot

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend (used for Stripe redirects + password-reset links)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Worker
WORKER_API_KEY=change-me-worker-key

# Set false in production when Stripe is live
BYPASS_SUBSCRIPTION_CHECK=false

# --- Stripe (put keys here → restart API → billing works) ---
# Live: sk_live_... / whsec_... / price_...
# Test: sk_test_... / whsec_... / price_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Password-reset emails (API SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# S3 (downloads)
AWS_REGION=eu-north-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRE_SECONDS=3600

# Celery (optional)
CELERY_ENABLED=false
CELERY_BROKER_URL=
CELERY_TASK_QUEUE=snapshot_jobs
